async function share(id){
  const x=find(id);const url="https://claude.ai/artifact/18WLW2rkxZ6sAGptFT6nJq#"+id;
  try{if(navigator.share){await navigator.share({title:x?x.title:"VideoHub",url});return}}catch(e){if(e&&e.name==="AbortError")return}
  try{await navigator.clipboard.writeText(url);alert(t("Link kopiert."))}catch(e){prompt(t("Link zum Teilen:"),url)}
}
