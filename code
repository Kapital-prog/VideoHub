    case"delc":if(confirm(t("Kommentar löschen?")))rm("comments",i);break;
    case"delitem":if(confirm(t("Diesen Inhalt endgültig löschen?"))){await bDel(i);dropUrl(i);cur=null;dlg.close();rm("items",i)}break;
    case"sv":{const v=$("#pls").value;if(v==="new"){newPl(i);break}const p=merged("playlists").find(x=>x.id===v);if(p&&!p.items.includes(i))put("playlists",{...p,items:[...p.items,i]});alert(t("Zur Playlist hinzugefügt."));break}
    case"sub":{const x=find(i);if(!x||!x.owner)break;const sid=me.id+"_"+x.owner;if(merged("subs").some(s=>s.id===sid))rm("subs",sid);else{put("subs",{id:sid,owner:me.id,channel:x.owner,channelName:x.ownerName||"Gast",ts:Date.now()});notify(x.owner,"sub","","")}break}
    case"rep":{const r=prompt(t("Warum meldest du diesen Inhalt? (z. B. Spam, Gewalt, Urheberrecht)"));if(r&&r.trim()){put("reports",{id:i+"_"+me.id,item:i,owner:me.id,reason:r.trim().slice(0,200),ts:Date.now()});alert(t("Danke, die Meldung wurde gesendet."))}break}
    case"reps":reps();break;
    case"repdel":if(confirm(t("Gemeldeten Inhalt löschen?"))){merged("reports").filter(r=>r.item===i).forEach(r=>rm("reports",r.id));rm("items",i);reps()}break;
    case"repdis":rm("reports",i);reps();break;
    case"retry":{const x=loc.items.find(v=>v.id===i);if(x){delete x.err;save()}sync();view(i,true);break}
    case"edit":editForm(i);break;
    case"editc":{const c=merged("comments").find(v=>v.id===i);if(!c||c.owner!==me.id)break;const v=prompt(t("Kommentar bearbeiten"),c.text);if(v&&v.trim())put("comments",{...c,text:v.trim().slice(0,500),edited:Date.now()});break}
