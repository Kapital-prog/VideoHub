    case"newpl":newPl();break;
    case"pl":plView(i);break;
    case"rmpl":{const p=merged("playlists").find(x=>x.id===d.p);if(p){put("playlists",{...p,items:p.items.filter(x=>x!==i)});plView(d.p)}break}
    case"delpl":if(confirm(t("Playlist löschen?"))){dlg.close();rm("playlists",i)}break;
  }
