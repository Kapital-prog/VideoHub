    case"repdelc":if(confirm(t("Kommentar löschen?"))){merged("reports").filter(r=>r.cid===i).forEach(r=>rm("reports",r.id));rm("comments",i);reps()}break;
    case"subadd":subForm(i);break;
    case"cal":calView();break;
    case"newg":newGroup();break;
    case"joing":joinGroup();break;
